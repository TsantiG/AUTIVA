      //   "command": ["npx", "-y", "chrome-devtools-mcp@VERSION_VALIDADA"],
      //   "disabled": true
      // }
    }
  }
  // Plugin original, opcional: verificar compatibilidad V2 antes de activarlo.
  // , "plugins": ["opencode-ignore"]
}
