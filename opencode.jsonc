{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode V2. Requiere modelos disponibles en el proveedor configurado.
  "default_agent": "plan",
  "agents": {
    "plan": { "model": "openai/gpt-6-luna#medium" },
    "build": { "model": "openai/gpt-6.1-sol#medium" }
  },
  "mcp": {
    "servers": {
      // Ejemplo INACTIVO. Sustituir VERSION_VALIDADA, autorizar y descomentar.
